# Torn Command Center - Environment variables
# Copy to .env.local and fill in real values

# Supabase
VITE_SUPABASE_URL=https://caxhhhtrlqfuatraamto.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (never expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# Torn API
TORN_KEY_ENCRYPTION_KEY=your-base64-32-byte-key-here

# AI (optional, for war analyzer)
AI_PROVIDER_API_KEY=your-openai-key-here

# Test
VITE_TEST_SELLER_EMAIL=test-seller@test.com
VITE_TEST_OPERATOR_EMAIL=test-operator@test.com
VITE_TEST_BUYER_EMAIL=test-buyer@test.com
VITE_TEST_PASSWORD=test-password-123
