{
  "name": "torn-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "vitest run src/__tests__/edge-functions.test.ts",
    "test:payout": "vitest run src/__tests__/payout-workflow.test.ts",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "types": "supabase gen types typescript --project-id caxhhhtrlqfuatraamto > src/types/supabase.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "recharts": "^2.12.0",
    "@tanstack/react-query": "^5.51.0",
    "date-fns": "^3.6.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vitest": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "supabase": "^1.192.0"
  }
